# Worker-only configuration. Set privately in Muse; worker.py reads environment
# variables, not this file automatically. Never give the worker BRIDGE_USER_KEY.
BRIDGE_URL=https://muse.example.com
BRIDGE_WORKER_KEY=replace-with-worker-key-from-bridge-vps

# Optional outbound HTTP CONNECT proxy (HTTPS requests remain TLS-verified).
# Leave empty to inherit the platform's normal HTTP_PROXY/HTTPS_PROXY/NO_PROXY.
# Protect the actual file (chmod 600) if the proxy URL contains credentials.
BRIDGE_PROXY_URL=
# Example only: http://proxy.example.com:3128
# Credentials must be URL-encoded. SOCKS5 and TLS-to-proxy URLs are unsupported.
