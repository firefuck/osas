# Generate actual keys with: python3 scripts/init_env.py
BRIDGE_USER_KEY=replace-with-random-user-key
BRIDGE_WORKER_KEY=replace-with-different-random-worker-key
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_DB=.local/bridge.sqlite3
BRIDGE_TIMEOUT=240
BRIDGE_LEASE_SECONDS=300
BRIDGE_MAX_PENDING=32

# queue: Muse scheduled worker pulls jobs. muse2api: call a local Muse2API adapter.
BRIDGE_BACKEND=queue
MUSE_UPSTREAM_URL=http://127.0.0.1:18610/v1
MUSE_UPSTREAM_KEY=
MUSE_UPSTREAM_MODEL=muse-spark

# emulate: prompt protocol + schema validation; native: verified upstream only.
BRIDGE_TOOL_MODE=emulate
# Responses history is stored by default; send store=false to opt out.
BRIDGE_RESPONSE_TTL=3600
BRIDGE_RESPONSE_CAPACITY=128

# Optional public, operator-verified upstream model contract (no keys in file).
# Unknown limits/replay remain unverified; see MODEL_CONTRACT.md.
BRIDGE_MODEL_PROFILE=

# best_effort forwards unverified replay/budgets; strict restores 422 guards.
BRIDGE_CAPABILITY_POLICY=best_effort
